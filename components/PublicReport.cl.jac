# Public read-only view of a SHARED report — /report/<token>, outside the auth
# Gate. Renders the frozen snapshot served by report_public (def:pub): no
# sidebar, no pickers, no queries — a document. Print = the PDF export.
sv import from ..metrics_sv { report_public }
import from .pages.ReportsPage { SectionBlock }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription }
import from .ui.badge { Badge }
import from .ui.skeleton { Skeleton }
import from .ui.tooltip { TooltipProvider }
import from .dash.util { utc_to_local, tz_name }

def _token_from_path() -> str {
    p = str(window.location.pathname);
    if p.startswith("/report/") {
        return p[8:];
    }
    return "";
}

def:pub PublicReport() -> JsxElement {
    has loading: bool = True;
    has found: bool = False;
    has rep: dict = {};

    async can with entry {
        tok = _token_from_path();
        if tok == "" {
            found = False;
            loading = False;
            return;
        }
        try {
            res = (await report_public(tok)) as dict;
            found = res.get("found", False) as bool;
            rep = res.get("report", {}) as dict;
        } except Exception as e {
            found = False;
        }
        loading = False;
    }

    # precompute section render dicts (same shape SectionBlock expects)
    secs: list = [];
    hdr_sub = "";
    title = str(rep.get("title", "Report"));
    masked = rep.get("masked", False) as bool;
    if found {
        hdr_sub = utc_to_local(str(rep.get("from_dt", ""))) + " → " + utc_to_local(str(rep.get("to_dt", ""))) + " (" + tz_name() + ")";
        blt = str(rep.get("built_at", ""));
        if blt {
            hdr_sub = hdr_sub + " · data frozen " + utc_to_local(blt);
        }
        snap = rep.get("snapshot", {}) as dict;
        for s in (rep.get("sections", []) as list) {
            sd = s as dict;
            sid = str(sd.get("id", ""));
            typ = str(sd.get("type", ""));
            fr = {"id": sid, "type": typ, "title": str(sd.get("title", "")), "md": str(sd.get("md", "")),
                  "chart": "", "data": {}, "built": False};
            if (typ == "tile") or (typ == "table") {
                sn = snap.get(sid, {}) as dict;
                if sn {
                    fr["chart"] = str(sn.get("chart", "table"));
                    fr["data"] = sn.get("data", {});
                    fr["built"] = True;
                } else {
                    continue;
                }
            }
            secs = secs + [fr];
        }
    }

    return <TooltipProvider><div className="min-h-svh bg-background">
        <div className="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8">
            {if loading {
                <Skeleton className="h-40 w-full" />
            } elif not found {
                <Card>
                    <CardHeader>
                        <CardTitle className="text-base">Report not found</CardTitle>
                        <CardDescription className="text-sm">This share link is invalid or has been revoked.</CardDescription>
                    </CardHeader>
                </Card>
            } else {
                <div className="flex flex-col gap-4">
                    <div className="flex flex-col gap-1">
                        <div className="flex flex-wrap items-center gap-2">
                            <h1 className="text-2xl font-semibold tracking-tight">{title}</h1>
                            <Badge variant="secondary">shared snapshot</Badge>
                            {if masked {
                                <Badge variant="outline">emails masked</Badge>
                            }}
                        </div>
                        <p className="text-sm text-muted-foreground">{hdr_sub}</p>
                    </div>
                    <div className="grid grid-cols-12 gap-4">
                        {for fr in secs {
                            <SectionBlock key={str(fr["id"])} fr={fr} />
                        }}
                    </div>
                    <p className="border-t border-border pt-3 text-[11px] text-muted-foreground">Generated by JacHammer Analytics · numbers are environment-filtered and frozen at build time.</p>
                </div>
            }}
        </div>
    </div></TooltipProvider>;
}
